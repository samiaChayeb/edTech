# ============================
# EdTech Platform - Configuration
# ============================

# ── General ──
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://edtech:edtech_secret@localhost:5432/edtech_db?schema=public
POSTGRES_USER=edtech
POSTGRES_PASSWORD=edtech_secret
POSTGRES_DB=edtech_db

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=super-secret-change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# ── File Upload ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# ── Stripe (test mode) ──
STRIPE_SECRET_KEY=sk_test_mock_key_replace_me
STRIPE_WEBHOOK_SECRET=whsec_mock_secret
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key_replace_me

# ── CORS ──
CORS_ORIGINS=http://localhost:3000
